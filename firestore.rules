rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.name is string && data.name.size() <= 128 &&
             data.freeLifetime is bool &&
             (!('photo' in data) || data.photo == null || (data.photo is string && data.photo.size() <= 1024)) &&
             (!('updatedAt' in data) || data.updatedAt == null || data.updatedAt is timestamp);
    }

    function isValidAgentMemory(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.agentId is string && data.agentId.size() <= 64 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.agentName is string && data.agentName.size() <= 64 &&
             data.memoryJson is string && data.memoryJson.size() <= 100000 &&
             (!('updatedAt' in data) || data.updatedAt == null || data.updatedAt is timestamp);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photo', 'freeLifetime', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId;

      // Per-user Agent Memories Subcollection
      match /agent_memories/{agentId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidAgentMemory(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidAgentMemory(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['agentName', 'memoryJson', 'updatedAt']);

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
